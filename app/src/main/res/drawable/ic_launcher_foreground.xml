<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive foreground bounds vary by launcher/icon size; fixed dp dimensions crop
     the bitmap at small sizes. Fractional insets scale with the actual bounds. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="20%">
    <bitmap
        android:gravity="fill"
        android:src="@drawable/contako_mascot_v2" />
</inset>
