    <string name="about_features_summary">Create, edit and search contacts, including offline.\nPhotos, multiple addresses and groups are supported. Groups belong to individual email addresses in Proton.</string>
    <string name="about_sync">How synchronization works</string>
    <string name="about_sync_summary">Changes are saved on this phone before upload to Proton. Android receives an editable copy.\nThe Synchronization tab shows pending changes and problems. Background sync depends on network and Android settings.</string>
    <string name="about_limits">Keep in mind</string>
    <string name="about_limits_summary">One Proton account at a time. Contacts from other Android accounts are not imported automatically.\nSome system editors hide fields; Contako preserves them. Custom labeled dates stay local.\nFIDO-only sign-in is not supported.</string>
    <string name="about_privacy_summary">No ads, analytics or remote crash reporting. Diagnostics are exported only on request. Android backup and device transfer are disabled for Contako data.</string>
